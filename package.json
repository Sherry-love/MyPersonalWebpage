{
  "name": "impressionist-garden",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "刘东徽的个人主页：印象派花园",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-contributions.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "fetch:contributions": "node scripts/fetch-contributions.mjs",
    "assets:images": "python scripts/build-images.py",
    "assets:font": "python scripts/build-font-subset.py"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "lenis": "^1.3.23",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.12.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.2",
    "vite": "^5.4.21"
  }
